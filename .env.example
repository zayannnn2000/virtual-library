# Copy to .env.local and fill in. Everything is optional:
# leave it all empty to run the library on this device only (no PIN, no sync).

# Supabase → Project Settings → API (the anon / publishable key, never service_role)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The account the PIN signs in to; "Forgot PIN?" emails go here
VITE_LIBRARY_EMAIL=

# Google Cloud → Books API key (restrict it to your site's address)
VITE_GOOGLE_BOOKS_KEY=
